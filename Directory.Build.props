<Project>

  <!--
    Single source of truth for assembly versioning across the whole solution.

    - <Version> drives <AssemblyVersion>, <FileVersion>, <InformationalVersion>
      automatically when none of those are explicitly set.
    - The CI workflow at .github/workflows/release.yml reads this exact value
      to tag and pack the Velopack release. Bump it here, push a tag v<value>,
      and the GitHub Action will publish a fresh installer + delta package.
    - Keep it strict SemVer (MAJOR.MINOR.PATCH). Pre-release suffixes are
      allowed (e.g. "1.2.0-beta.1") and Velopack's GithubSource will pick
      them up only when the user opts into the pre-release channel from
      Settings.
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Olrik-WP</Authors>
    <Company>SC DataRunner</Company>
    <Product>SC DataRunner</Product>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Olrik-WP</Copyright>
    <RepositoryUrl>https://github.com/Olrik-WP/SC-DataRunnerNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Embed the source-revision (git SHA, set by CI) into InformationalVersion
       so crash reports / "About" cards can pinpoint the exact build. -->
  <PropertyGroup>
    <SourceRevisionId Condition=" '$(SourceRevisionId)' == '' ">local</SourceRevisionId>
    <InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>
  </PropertyGroup>

</Project>
