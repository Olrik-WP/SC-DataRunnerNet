<Project>

  <!--
    Single source of truth for assembly versioning across the whole solution.

    - <Version> drives <AssemblyVersion>, <FileVersion>, <InformationalVersion>
      automatically when none of those are explicitly set.
    - The CI workflow at .github/workflows/release.yml reads this exact value
      to tag and pack the Velopack release. Bump it here, push a tag v<value>,
      and the GitHub Action will publish a fresh installer + delta package.
    - Keep it strict SemVer (MAJOR.MINOR.PATCH). Pre-release suffixes are
      allowed (e.g. "1.2.0-beta.1") and Velopack's GithubSource will pick
      them up only when the user opts into the pre-release channel from
      Settings.
  -->
  <PropertyGroup>
    <Version>1.3.0</Version>
    <Authors>Olrik-WP</Authors>
    <Company>SC DataRunner</Company>
    <Product>SC DataRunner</Product>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Olrik-WP</Copyright>
    <RepositoryUrl>https://github.com/Olrik-WP/SC-DataRunnerNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>

    <!--
      AGPL-3.0-or-later: this project is free software under the GNU Affero
      General Public License version 3 or any later version. The full license
      text is in /LICENSE at the repo root. SPDX identifiers below propagate
      the licensing metadata to NuGet packages, the Windows binary's "About"
      properties, and any tooling that scans the assembly attributes.
    -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageLicenseFile></PackageLicenseFile>
    <PackageProjectUrl>https://github.com/Olrik-WP/SC-DataRunnerNet</PackageProjectUrl>
  </PropertyGroup>

  <!-- Embed the source-revision (git SHA, set by CI) into InformationalVersion
       so crash reports / "About" cards can pinpoint the exact build. -->
  <PropertyGroup>
    <SourceRevisionId Condition=" '$(SourceRevisionId)' == '' ">local</SourceRevisionId>
    <InformationalVersion>$(Version)+$(SourceRevisionId)</InformationalVersion>
  </PropertyGroup>

  <!--
    Optional UEX app bearer token, embedded into every assembly via an
    AssemblyMetadata attribute when the MSBuild property is non-empty.

    The CI workflow (.github/workflows/release.yml) passes the GitHub Actions
    secret UEX_APP_BEARER_TOKEN as /p:UexAppBearerToken=... so official
    releases ship with the token already baked in — end users only need to
    paste their own UEX secret-key.

    Local builds without the env var produce no attribute, and the runtime
    falls back to asking the user for their own bearer token (the historical
    flow). To self-build with your own token:

        $env:UexAppBearerToken = 'your-token-here'
        dotnet publish src/DataRunner.App.Wpf/DataRunner.App.Wpf.csproj -c Release

    Or pass it directly:

        dotnet build /p:UexAppBearerToken=your-token-here

    The token is extractable from the binary (strings.exe, ILSpy, ...) — same
    trade-off every other datarunner tool makes. If it ever leaks publicly,
    rotate it on https://uexcorp.space/api/apps and ship a new release; users
    auto-update via Velopack within hours.
  -->
  <ItemGroup Condition="'$(UexAppBearerToken)' != ''">
    <AssemblyMetadata Include="UexAppBearerToken" Value="$(UexAppBearerToken)" />
  </ItemGroup>

</Project>
