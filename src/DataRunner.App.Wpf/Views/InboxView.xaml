<UserControl x:Class="DataRunner.App.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:views="clr-namespace:DataRunner.App.Views"
             xmlns:beh="clr-namespace:DataRunner.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:InboxViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="240" MaxWidth="500" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: list of pending screenshots -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Inbox"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Screenshots queued for review"
                                   FontSize="12" Opacity="0.65" Margin="0,2,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Primary"
                                       Command="{Binding ImportCommand}"
                                       Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                                    <TextBlock Text="Import images" />
                                </StackPanel>
                            </ui:Button>
                            <!-- Re-scan dropdown: click opens a menu with selectable time windows.
                                 Lets the user backfill older screenshots that were taken before the
                                 watcher was active or before the folder was configured. -->
                            <ui:Button x:Name="RescanButton"
                                       Margin="8,0,0,0"
                                       Click="OnRescanButtonClick"
                                       Padding="10,7"
                                       ToolTip="Re-scan the watched folder. Click to choose a time window (5 min / 1 h / 24 h / all).">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" Margin="4,0,0,0" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Last 5 minutes (live workflow)"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="5">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Last hour"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="60">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Clock24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Last 24 hours"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="1440">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="History24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="All screenshots in folder"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="0"
                                                  ToolTip="Imports every PNG/JPG in the folder, regardless of age. Use this to backfill old screenshots taken before the app was running.">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ImageMultiple24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0"
                                       Command="{Binding RemoveSelectedCommand}"
                                       Padding="10,7"
                                       ToolTip="Remove selected from inbox">
                                <ui:SymbolIcon Symbol="Delete24" />
                            </ui:Button>
                        </StackPanel>

                        <!-- Merge action — visible only when 2+ items with successful OCR are selected. -->
                        <ui:Button Margin="0,8,0,0"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Appearance="Secondary"
                                   Command="{Binding MergeSelectedCommand}"
                                   Padding="10,8"
                                   ToolTip="Combine the selected screenshots into a single submission (same terminal, deduplicated commodities). Use this when one terminal has more commodities than the in-game UI shows at once."
                                   Visibility="{Binding CanMergeSelected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageMultiple24" Margin="0,0,6,0" />
                                <TextBlock Text="Merge selected" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         beh:ListBoxSelectedItemsBehavior.SelectedItems="{Binding SelectedItems}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         Padding="8">
                    <ListBox.ItemContainerStyle>
                        <!-- Reset the default ListBoxItem chrome so OUR card is the one
                             that controls background. We add a 2px accent bar on the LEFT
                             via the IsSelected trigger — clean, immune to status colour. -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Card root: tinted by status (Pending/Ready/Review/Sent/Failed)
                                 via InboxStatusToBrush. Selection is shown by an accent border,
                                 NOT by repurposing the status colour, so the user always sees
                                 BOTH "what state am I in" and "what did I click on". -->
                            <Border Margin="2,3" Padding="10,8"
                                    CornerRadius="6"
                                    BorderThickness="2"
                                    Background="{Binding Status, Converter={StaticResource InboxStatusToBrush}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot + thumbnail. Click on the thumbnail opens
                                         the full-screen ImageViewer for a careful inspection. -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse Width="9" Height="9" Margin="0,2,0,6"
                                                 HorizontalAlignment="Left"
                                                 Fill="{Binding Status, Converter={StaticResource InboxStatusToDot}}" />
                                        <Border Width="96" Height="54" CornerRadius="3" ClipToBounds="True"
                                                Background="#222"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp"
                                                ToolTip="Click to open the full-size screenshot">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Text block: name, terminal · system, count + age. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TerminalLabel}"
                                                   FontSize="11" Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                        <TextBlock FontSize="10" Opacity="0.6" Margin="0,4,0,0">
                                            <Run Text="{Binding RowCount, Mode=OneWay}" />
                                            <Run Text=" rows · added " />
                                            <Run Text="{Binding AddedAt, StringFormat='HH:mm:ss', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusReason}"
                                                   FontSize="10" Opacity="0.55"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Status badge stays as a textual hint; redundant with
                                         the dot but useful for screen-readers / accessibility. -->
                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,2"
                                            VerticalAlignment="Top"
                                            Background="#33000000">
                                        <TextBlock Text="{Binding Status}" FontSize="10" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- SPLITTER between inbox and editor. ResizeBehavior=PreviousAndNext lets
             the user drag freely between the column min/max widths declared above. -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      ResizeBehavior="PreviousAndNext" />

        <!-- RIGHT: editor.
             We anchor the editor binding via RelativeSource so that the Visibility
             check looks at InboxViewModel.CurrentEditor regardless of any
             DataContext re-targeting that happens inside the ContentControl. -->
        <Grid Grid.Column="2" x:Name="EditorPanel">

            <!-- The editor itself. Wrapped in a Border whose visibility is bound
                 to the parent Grid's DataContext (the InboxViewModel) so we are
                 immune to inner DataContext shenanigans. -->
            <Border Visibility="{Binding DataContext.CurrentEditor,
                                          ElementName=EditorPanel,
                                          Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{Binding DataContext.CurrentEditor, ElementName=EditorPanel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:ScreenshotEditViewModel}">
                            <views:ScreenshotEditView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>

            <!-- Empty state (shown only when nothing is selected) -->
            <Border IsHitTestVisible="False"
                    Visibility="{Binding DataContext.CurrentEditor,
                                          ElementName=EditorPanel,
                                          Converter={StaticResource BoolToVisibility},
                                          ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                    <ui:SymbolIcon Symbol="ImageEdit24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick a screenshot in the inbox to start"
                               FontSize="16" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Or click 'Import images' to add some."
                               FontSize="12" Opacity="0.7" Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
