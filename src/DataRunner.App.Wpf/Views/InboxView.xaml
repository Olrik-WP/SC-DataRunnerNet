<UserControl x:Class="DataRunner.App.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:views="clr-namespace:DataRunner.App.Views"
             xmlns:beh="clr-namespace:DataRunner.App.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:InboxViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <!-- Slightly wider default so the toolbar row (Import / rescan /
                             delete / open-folder) does not clip on typical layouts. -->
                        <Setter Property="Width" Value="380" />
                        <Setter Property="MinWidth" Value="300" />
                        <Setter Property="MaxWidth" Value="560" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter Property="Width" Value="52" />
                                <Setter Property="MinWidth" Value="52" />
                                <Setter Property="MaxWidth" Value="52" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: list of pending screenshots (collapsible) -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">

            <Grid>
                <!-- COLLAPSED STRIP — expand control + queue count + one clickable
                     thumbnail per inbox item (same idea as the icon-only nav rail).
                     Picks the active screenshot/editor without expanding the full list. -->
                <Grid HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <ui:Button Command="{Binding ToggleCollapsedCommand}"
                                   Appearance="Secondary"
                                   Width="32" Height="32" Padding="0"
                                   ToolTip="Expand inbox">
                            <ui:SymbolIcon Symbol="ChevronRight24" />
                        </ui:Button>
                        <Border Margin="0,8,0,0" CornerRadius="10" Padding="6,2"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="{Binding Items.Count, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Items.Count}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,10,0,8"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}"
                                      HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InboxItem}">
                                    <ui:Button Appearance="Transparent"
                                               Padding="0"
                                               Margin="0,0,0,6"
                                               HorizontalAlignment="Center"
                                               Command="{Binding DataContext.SelectFromCollapsedRailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="{Binding DisplayName}">
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="#2C2C2C"
                                                BorderThickness="2"
                                                Padding="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush"
                                                            Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource RefEqual}">
                                                                    <Binding Path="DataContext.SelectedItem"
                                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    <Binding />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush"
                                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,2,2"
                                                        CornerRadius="3"
                                                        Padding="3,0"
                                                        Background="#CC000000">
                                                    <TextBlock Foreground="White"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Text="{Binding QueuePosition}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- FULL CONTENT — visible only when NOT collapsed. Same layout as
                     before (Import / rescan dropdown / delete / open-folder /
                     merge / list of cards). -->
            <DockPanel Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <Border DockPanel.Dock="Top" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right"
                                       Command="{Binding ToggleCollapsedCommand}"
                                       Appearance="Secondary"
                                       Padding="6" Width="28" Height="28"
                                       ToolTip="Collapse inbox to free space for the editor">
                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                            </ui:Button>
                            <StackPanel>
                                <TextBlock Text="Inbox"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Screenshots queued for review"
                                           FontSize="12" Opacity="0.65" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Appearance="Primary"
                                       Command="{Binding ImportCommand}"
                                       Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,6,0" />
                                    <TextBlock Text="Import images" />
                                </StackPanel>
                            </ui:Button>
                            <!-- Re-scan dropdown: click opens a menu with selectable time windows.
                                 Lets the user backfill older screenshots that were taken before the
                                 watcher was active or before the folder was configured. -->
                            <ui:Button x:Name="RescanButton"
                                       Margin="8,0,0,0"
                                       Click="OnRescanButtonClick"
                                       Padding="10,7"
                                       ToolTip="Re-scan the watched folder. Click to choose a time window (5 min / 1 h / 24 h / all).">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" Margin="4,0,0,0" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Last 5 minutes (live workflow)"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="5">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Last hour"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="60">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Clock24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Last 24 hours"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="1440">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="History24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="All screenshots in folder"
                                                  Command="{Binding RescanFolderCommand}"
                                                  CommandParameter="0"
                                                  ToolTip="Imports every PNG/JPG in the folder, regardless of age. Use this to backfill old screenshots taken before the app was running.">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ImageMultiple24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <!-- Trash dropdown — single click runs the default
                                 (Remove selected); the chevron opens a menu of
                                 bulk variants (Remove all sent / failed / all).
                                 Same UI affordance as the Re-scan button so the
                                 toolbar feels coherent. -->
                            <ui:Button x:Name="TrashButton"
                                       Margin="8,0,0,0"
                                       Click="OnTrashButtonClick"
                                       Padding="10,7"
                                       ToolTip="Remove from inbox. Click for selected, or use the menu for bulk delete (sent / failed / all).">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" />
                                    <ui:SymbolIcon Symbol="ChevronDown24" Margin="4,0,0,0" FontSize="11" Opacity="0.7" />
                                </StackPanel>
                                <ui:Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove selected"
                                                  Command="{Binding RemoveSelectedCommand}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove all sent"
                                                  Command="{Binding RemoveAllSentCommand}"
                                                  ToolTip="Drops every Sent item from the inbox. Their submission entry stays in History.">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Remove all failed"
                                                  Command="{Binding RemoveAllFailedCommand}"
                                                  ToolTip="Drops every Failed item. Useful after triaging which ones you want to retry vs. discard.">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ErrorCircle24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove ALL (with confirm)"
                                                  Command="{Binding RemoveAllCommand}"
                                                  ToolTip="Clears the entire inbox. Items currently being OCR-processed are kept.">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Broom24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:Button.ContextMenu>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0"
                                       Command="{Binding OpenScreenshotsFolderCommand}"
                                       Padding="10,7"
                                       ToolTip="Open the screenshots folder in Explorer">
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button>
                        </StackPanel>

                        <!-- BATCH SEND TOOLBAR
                             Primary line: "Send batch (X / Y ready)" — only enabled
                             when EVERY non-terminal item is Validated AND at least
                             one is. The button itself opens the BatchPreviewDialog
                             with the smart-split plan; the user confirms; the
                             submitter then fires the per-item POSTs sequentially.
                             Secondary line: "Retry failed (N)" / "Stop batch" —
                             visible only when relevant. -->
                        <Border Margin="0,12,0,0" Padding="0,8,0,0"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel>
                                <ui:Button HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Center"
                                           Appearance="Primary"
                                           Padding="10,9"
                                           Command="{Binding SendBatchCommand}"
                                           ToolTip="Plans the smart-split batch and shows the preview dialog before any POST. Disabled until every screenshot has been validated.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Send24" Margin="0,0,8,0" />
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="Send batch (" /><Run Text="{Binding BatchSummary, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </ui:Button>
                                <DockPanel Margin="0,8,0,0">
                                    <ui:Button DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               Appearance="Caution"
                                               Padding="10,6"
                                               Command="{Binding StopBatchCommand}"
                                               Visibility="{Binding IsBatchInProgress, Converter={StaticResource BoolToVisibility}}"
                                               ToolTip="Cancels the in-flight batch. The current POST finishes; remaining items stay Validated for a later send.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Stop24" Margin="0,0,4,0" />
                                            <TextBlock Text="Stop" FontSize="11" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Center"
                                               Appearance="Secondary"
                                               Padding="10,6"
                                               Command="{Binding RetryFailedCommand}"
                                               Visibility="{Binding HasFailedItems, Converter={StaticResource BoolToVisibility}}"
                                               ToolTip="Re-arms a Send batch run on the Failed items only. Useful after a transient HTTP 5xx the auto-retry couldn't ride out.">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,6,0" />
                                            <TextBlock>
                                                <Run Text="Retry failed (" /><Run Text="{Binding FailedCount, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>
                                    </ui:Button>
                                </DockPanel>
                                <!-- In-flight progress hint. Visible only during a batch run. -->
                                <Border Margin="0,8,0,0" Padding="8,5" CornerRadius="4"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding IsBatchInProgress, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock FontSize="11" Opacity="0.85"
                                                   VerticalAlignment="Center"
                                                   Text="Batch in progress... watch each card for per-item status." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         beh:ListBoxSelectedItemsBehavior.SelectedItems="{Binding SelectedItems}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         Padding="8">
                    <ListBox.ItemContainerStyle>
                        <!-- Reset the default ListBoxItem chrome so OUR card is the one
                             that controls background. We add a 2px accent bar on the LEFT
                             via the IsSelected trigger — clean, immune to status colour. -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Card root: tinted by status (Pending/Ready/Review/Sent/Failed)
                                 via InboxStatusToBrush. Selection is shown by an accent border,
                                 NOT by repurposing the status colour, so the user always sees
                                 BOTH "what state am I in" and "what did I click on". -->
                            <Border Margin="2,3" Padding="10,8"
                                    CornerRadius="6"
                                    BorderThickness="2"
                                    Background="{Binding Status, Converter={StaticResource InboxStatusToBrush}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot + thumbnail. Click on the thumbnail opens
                                         the full-screen ImageViewer for a careful inspection.
                                         Overlay badges: a green check-circle when Validated,
                                         a small spinner + "Sending..." when Sending. -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Ellipse Width="9" Height="9" Margin="0,2,4,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource InboxStatusToDot}}" />
                                            <Border VerticalAlignment="Center" CornerRadius="4" Padding="4,1"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    ToolTip="Queue position in the inbox">
                                                <TextBlock FontSize="10" FontWeight="SemiBold" Opacity="0.9">
                                                    <Run Text="#" />
                                                    <Run Text="{Binding QueuePosition, Mode=OneWay}" />
                                                </TextBlock>
                                            </Border>
                                            <!-- VALIDATED badge — small green check next to the queue # -->
                                            <Border Margin="4,0,0,0" CornerRadius="8" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="#1FA34A"
                                                    ToolTip="Validated &#x2014; will be included in the next batch send"
                                                    Visibility="{Binding IsValidated, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" Foreground="White" />
                                                    <TextBlock Text="OK" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="White" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <!-- SENDING badge — visible only while this item's POST is in flight. -->
                                            <Border Margin="4,0,0,0" CornerRadius="8" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Background="#2F8FCB"
                                                    ToolTip="POST in flight..."
                                                    Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:ProgressRing IsIndeterminate="True"
                                                                     Width="10" Height="10"
                                                                     VerticalAlignment="Center" />
                                                    <TextBlock Text="Sending" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="White" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Border Width="96" Height="54" CornerRadius="3" ClipToBounds="True"
                                                Background="#222"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp"
                                                ToolTip="Click to open the full-size screenshot">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Text block: name + branch pill, terminal · system, status + count + age, reason. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <DockPanel>
                                            <!-- Branch pill: green LIVE / orange PTU. Tells the user
                                                 at a glance which folder the screenshot was picked
                                                 up from (and therefore which game_version will be
                                                 sent to UEX). Hidden for LIVE on small/dense lists
                                                 would be nicer, but at this size the colour cue is
                                                 worth keeping for both. -->
                                            <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                    CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1FA34A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPtu}" Value="True">
                                                                <Setter Property="Background" Value="#D97706" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="9" FontWeight="SemiBold"
                                                           Foreground="White">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="LIVE" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPtu}" Value="True">
                                                                    <Setter Property="Text" Value="PTU" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ImagePath}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding TerminalLabel}"
                                                   FontSize="11" Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                        <!-- Status text + row count + age on one compact line.
                                             Status is also encoded in the dot colour and the
                                             card background tint, but having it as text avoids
                                             color-only encoding and helps accessibility. -->
                                        <TextBlock FontSize="10" Opacity="0.7" Margin="0,4,0,0"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding RowCount, Mode=OneWay}" />
                                            <Run Text=" rows · " />
                                            <Run Text="{Binding AddedAt, StringFormat='HH:mm:ss', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusReason}"
                                                   FontSize="10" Opacity="0.55"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </Grid>
        </Border>

        <!-- SPLITTER between inbox and editor. ResizeBehavior=PreviousAndNext lets
             the user drag freely between the column min/max widths declared above. -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

        <!-- RIGHT: editor.
             We anchor the editor binding via RelativeSource so that the Visibility
             check looks at InboxViewModel.CurrentEditor regardless of any
             DataContext re-targeting that happens inside the ContentControl. -->
        <Grid Grid.Column="2" x:Name="EditorPanel">

            <!-- The editor itself. Wrapped in a Border whose visibility is bound
                 to the parent Grid's DataContext (the InboxViewModel) so we are
                 immune to inner DataContext shenanigans. -->
            <Border Visibility="{Binding DataContext.CurrentEditor,
                                          ElementName=EditorPanel,
                                          Converter={StaticResource BoolToVisibility}}">
                <ContentControl Content="{Binding DataContext.CurrentEditor, ElementName=EditorPanel}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:ScreenshotEditViewModel}">
                            <views:ScreenshotEditView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>

            <!-- Empty state — split into two mutually-exclusive views:
                 • "Pick a screenshot" when no item is selected
                 • "OCR in progress" when the selected item is still being
                   processed (the editor stays closed until OCR completes,
                   then OpenEditorIfReady auto-opens it).
                 Both Visibility values are computed entirely inside the Style
                 so triggers can override them; setting Visibility directly on
                 the element would override the trigger and cause overlap. -->

            <!-- Idle empty state: visible only when there's no editor AND no
                 selection to wait on. -->
            <Border IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.CurrentEditor, ElementName=EditorPanel, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" Value="Visible" />
                                    <Condition Binding="{Binding DataContext.IsSelectedProcessing, ElementName=EditorPanel}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                    <ui:SymbolIcon Symbol="ImageEdit24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick a screenshot in the inbox to start"
                               FontSize="16" Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Or click 'Import images' to add some."
                               FontSize="12" Opacity="0.7" Margin="0,4,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- OCR in-progress placeholder. Shown while the selected item is
                 Pending/Processing. -->
            <Border IsHitTestVisible="False"
                    Visibility="{Binding DataContext.IsSelectedProcessing,
                                          ElementName=EditorPanel,
                                          Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="48" Height="48"
                                     HorizontalAlignment="Center" />
                    <TextBlock Text="OCR in progress…"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="The editor will open automatically when the results are ready."
