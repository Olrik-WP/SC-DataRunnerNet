<UserControl x:Class="DataRunner.App.Views.ScreenshotEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:views="clr-namespace:DataRunner.App.Views"
             xmlns:models="clr-namespace:DataRunner.Core.Models;assembly=DataRunner.Core"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ScreenshotEditViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             xml:lang="en-US">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="StatusValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:InventoryStatus" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="TabValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:TerminalTab" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <!-- Three-row layout:
           Row 0 (Auto)  : compact title bar with "Show screenshot" action
           Row 1 (*)     : full-width scrollable form (terminal + commodities + metadata)
           Row 2 (Auto)  : sticky validation panel + send action bar (NEVER scrolled away)
         The screenshot preview is no longer rendered inline (it was eating ~40% of
         the editor width while showing mostly black padding). Instead, the title
         bar exposes a "Show screenshot" button that opens the same full-screen
         viewer (with zoom + pan) that the inbox thumbnail click uses. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: compact title bar with screenshot action on the right -->
        <Grid Grid.Row="0" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Validate before submission"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,2,0,0" FontSize="11"
                           Text="Review every value before clicking Send. The submission mode (LIVE / TEST) is set globally in Settings." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Side-by-side toggle. Standard WPF ToggleButton restyled to
                     match WPF-UI Buttons (rounded + accent fill when checked).
                     We use the native control because WPF-UI doesn't ship its
                     own ToggleButton variant. -->
                <ToggleButton IsChecked="{Binding SideBySideScreenshot, Mode=TwoWay}"
                              Padding="10,7" Margin="0,0,8,0"
                              ToolTip="Dock the source screenshot to the right of the form so you can verify OCR values without leaving the editor. Persisted across sessions.">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DualScreenGroup24" Margin="0,0,6,0" />
                        <TextBlock Text="Side-by-side" />
                    </StackPanel>
                </ToggleButton>

                <ui:Button Appearance="Secondary"
                           Padding="12,7"
                           Click="ShowScreenshot_Click"
                           ToolTip="Open the source screenshot in a full-screen viewer (zoom + pan).">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Image24" Margin="0,0,6,0" />
                        <TextBlock Text="Show screenshot" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: form + optional screenshot panel.
             - Column 0: scrollable form (always visible)
             - Column 1: GridSplitter (only when side-by-side is on)
             - Column 2: docked ScreenshotPanel (only when side-by-side is on)
             Min-width on Col 0 (520px) keeps the commodity DataGrid usable;
             min-width on Col 2 (220px) keeps the screenshot reference visible while
             favouring form width. The user can drag the splitter to balance them. -->
        <Grid Grid.Row="1" Margin="20,0,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SideBySideScreenshot}" Value="True">
                                    <Setter Property="Width" Value="1.6*" />
                                    <Setter Property="MinWidth" Value="220" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                <!-- MERGED-ITEM WARNING — visible only when this submission was built
                     from 2+ source screenshots. UEX accepts only ONE screenshot per
                     /data_submit POST, so only the first source image is attached.
                     New datarunners (90-day evaluation period) may see the submission
                     rejected if commodity rows from other source screenshots aren't
                     visually represented in the attached one. -->
                <Border Margin="0,0,0,12" Padding="12,10"
                        CornerRadius="6"
                        Background="#22F0AD4E" BorderBrush="#88F0AD4E" BorderThickness="1"
                        Visibility="{Binding IsMergedItem, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24"
                                       Margin="0,0,10,0" VerticalAlignment="Top"
                                       Foreground="#F0AD4E" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="12">
                                <Run Text="Merged from " />
                                <Run Text="{Binding MergedSourceCount, Mode=OneWay}" />
                                <Run Text=" screenshots — only the FIRST one is sent to UEX." />
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Opacity="0.85"
                                       Text="UEX accepts a single screenshot per submission. While you're in your 90-day evaluation period as a new datarunner, the manual reviewer may reject the submission for commodity rows whose visual evidence isn't on the one attached screenshot. If that happens, submit each screenshot individually until UEX validates you." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- TERMINAL CARD -->
                <ui:Card Margin="0,0,0,12" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="TERMINAL" Opacity="0.6" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Appearance="Secondary"
                                       Padding="10,4"
                                       Command="{Binding ReRunOcrCommand}"
                                       ToolTip="Re-run the OCR pipeline on this screenshot">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,4,0" FontSize="14" />
                                    <TextBlock Text="Re-run OCR" FontSize="11" />
                                </StackPanel>
                            </ui:Button>
                            <TextBlock HorizontalAlignment="Right" Margin="0,0,10,0"
                                       Text="{Binding TerminalMatchScore, StringFormat='match {0:F0}/100'}"
                                       FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Ambiguous-terminal warning banner. Visible only when the
                             current terminal name exists in 2+ star systems AND the
                             user has not explicitly confirmed a pick. -->
                        <Border Margin="0,8,0,0" Padding="10,6"
                                Background="#22C8504F" BorderBrush="#88C8504F"
                                BorderThickness="1" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAmbiguousTerminal}" Value="True" />
                                                <Condition Binding="{Binding UserExplicitlyConfirmedTerminal}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24"
                                               Margin="0,0,8,0" Foreground="IndianRed"
                                               VerticalAlignment="Center" />
                                <TextBlock TextWrapping="Wrap" FontSize="12">
                                    <Run Text="Ambiguous terminal: this name exists in multiple star systems." FontWeight="SemiBold" />
                                    <LineBreak />
                                    <Run Text="Pick the correct one in the dropdown below — candidates are pinned at the top." />
                                </TextBlock>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <ui:TextBox x:Name="TerminalSearchBox"
                                        Text="{Binding TerminalSearch, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Search terminal by name, code, station, outpost…"
                                        GotKeyboardFocus="TerminalSearchBox_GotKeyboardFocus"
                                        PreviewMouseLeftButtonDown="TerminalSearchBox_PreviewMouseLeftButtonDown"
                                        PreviewKeyDown="TerminalSearchBox_PreviewKeyDown" />
                            <Popup x:Name="TerminalSuggestionsPopup"
                                   IsOpen="{Binding IsTerminalDropDownOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=TerminalSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Width="{Binding ActualWidth, ElementName=TerminalSearchBox}">
                                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="0" Margin="0,4,0,0">
                                    <ListBox MaxHeight="280"
                                             ItemsSource="{Binding TerminalSuggestions}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             PreviewMouseWheel="TerminalSuggestionList_PreviewMouseWheel">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="10,6" />
                                                <EventSetter Event="PreviewMouseLeftButtonUp"
                                                             Handler="TerminalSuggestion_Picked" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <!-- Show "Display Name · Star System" so the user disambiguates
                                                         multi-system terminals (Pyro Gateway, ARC-L1, etc.) at a glance. -->
                                                    <TextBlock Text="{Binding RichDisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding LocationLabel}"
                                                               FontSize="11" Opacity="0.65"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Resolved-terminal confirmation. Visible whenever a
                             terminal is actually bound to the form (so the
                             user can SEE which one without inspecting the
                             payload), with a green check + the canonical
                             "Shop · Station · System" label. Critical for
                             the auto-resolve path where the search box still
                             shows the user's typed text rather than the
                             canonical label. Resolves issue #3 point 4. -->
                        <Border Margin="0,6,0,0" Padding="8,4"
                                Background="#1F4CAF50" BorderBrush="#664CAF50"
                                BorderThickness="1" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedTerminal}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" Margin="0,0,8,0"
                                           Foreground="#4CAF50"
                                           VerticalAlignment="Center" />
                                <TextBlock TextWrapping="Wrap" FontSize="12">
                                    <Run Text="Bound:" FontWeight="SemiBold" Foreground="#88FFFFFF" />
                                    <Run Text="{Binding SelectedTerminal.RichDisplayName, Mode=OneWay, FallbackValue=''}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TAB" Opacity="0.6" FontSize="11"
                                           FontWeight="SemiBold" />
                                <ComboBox Margin="0,4,0,0"
                                          ItemsSource="{Binding Source={StaticResource TabValues}}"
                                          SelectedItem="{Binding Tab, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="CONTAINER SIZES (SCU)" Opacity="0.6" FontSize="11"
                                           FontWeight="SemiBold" />
                                <ui:TextBox Margin="0,4,0,0"
                                            Text="{Binding ContainerSizes, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="e.g. 1,2,4,8,16,24,32" />
                            </StackPanel>
                        </Grid>

                        <!-- Tab-undetected warning banner. Shown in bright
                             amber when the colour-based detector couldn't
                             decide BUY vs SELL (eg. Pyro Gateway, faction
                             stations with low saturation gap). The Send
                             button stays disabled via the matching
                             "tab_unknown" blocking validation rule until
                             the user picks a side in the TAB dropdown. -->
                        <Border Margin="0,10,0,0" Padding="12,10"
                                CornerRadius="4"
                                Background="#33D97706"
                                BorderBrush="#FFD97706"
                                BorderThickness="1"
                                Visibility="{Binding IsTabUndetected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning20"
                                               Foreground="#FFFFCC80"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" FontSize="13"
                                               Foreground="#FFFFCC80"
                                               Text="Buy / Sell tab not detected" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="#FFFFE8C2"
                                               Text="The OCR couldn't tell which tab was active in the screenshot (this happens on amber-themed Pyro stations). Pick BUY or SELL in the dropdown above before sending — submitting the wrong side pollutes UEX with mirrored prices in the opposite column." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="11" Opacity="0.55" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   Text="{Binding TerminalFromOcr, StringFormat='OCR fragment: {0}'}" />
                    </StackPanel>
                </ui:Card>

                <!-- ROWS -->
                <ui:Card Margin="0,0,0,12" Padding="0">
                    <StackPanel>
                        <DockPanel Margin="16,12,16,8">
                            <TextBlock Text="COMMODITY ROWS" Opacity="0.6" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Appearance="Secondary"
                                       Command="{Binding AddRowCommand}"
                                       Padding="10,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Margin="0,0,4,0" />
                                    <TextBlock Text="Add row" />
                                </StackPanel>
                            </ui:Button>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  RowHeight="40"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="Transparent"
                                  Margin="0,0,4,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Commodity" Width="2*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.CommodityOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Commodity, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Name"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      IsTextSearchCaseSensitive="False"
                                                      TextSearch.TextPath="Name"
                                                      StaysOpenOnEdit="True"
                                                      Margin="2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="SCU" Width="90" MinWidth="70"
                                                    Binding="{Binding ScuValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource SmartNumber}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <!-- Cell-level style to colour the entire cell background when SCU is missing.
                                         Using CellStyle (vs ElementStyle) so the highlight covers the whole cell,
                                         not just the text inside. -->
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ScuIsEmpty}" Value="True">
                                                    <Setter Property="Background" Value="#33C8504F" />
                                                    <Setter Property="ToolTip" Value="SCU is required (or set the in-game status to 'Out of stock')." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Price (aUEC/SCU)" Width="130" MinWidth="100"
                                                    Binding="{Binding PriceValue, UpdateSourceTrigger=LostFocus, Converter={StaticResource SmartNumber}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,8,0" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PriceIsEmpty}" Value="True">
                                                    <Setter Property="Background" Value="#33C8504F" />
                                                    <Setter Property="ToolTip" Value="Price is required for this row." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="*" MinWidth="120">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Style.Triggers>
                                                <!-- Tint the cell orange when the inventory status was not detected
                                                     by OCR. This is consistent with the orange Warning band in the
                                                     validation footer ("inventory status is Unknown — pick one"). -->
                                                <DataTrigger Binding="{Binding StatusIsUnknown}" Value="True">
                                                    <Setter Property="Background" Value="#33DAA520" />
                                                    <Setter Property="ToolTip" Value="OCR did not detect this row's inventory status — pick one (Maximum / High / ...)." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource StatusValues}}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                      Margin="2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Match score: rendered as a small coloured pill (green ≥95, orange 80-94, red <80)
                                     instead of plain text, so the user sees at a glance which OCR results are
                                     trustworthy. Foreground brush comes from MatchSeverity ("Ok"/"Warning"/"Error")
                                     piped through the existing SeverityToBrushConverter. -->
                                <DataGridTemplateColumn Header="Match" Width="58" MinWidth="52" SortMemberPath="MatchScore">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="6,2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,4,0"
                                                    Background="{Binding MatchSeverity, Converter={StaticResource SeverityToBrush}}"
                                                    Opacity="0.85">
                                                <TextBlock Text="{Binding MatchScore, StringFormat=F0}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="48" MinWidth="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ui:Button Appearance="Transparent"
                                                       Padding="6,4"
                                                       HorizontalAlignment="Center"
                                                       Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}"
                                                       ToolTip="Remove this row">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                            </ui:Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>

                <!-- METADATA CARD -->
                <ui:CardExpander Margin="0,0,0,12" Header="Optional metadata (game version, details)">
                    <StackPanel Margin="16,4,16,12">
                        <TextBlock Text="GAME VERSION" Opacity="0.6" FontSize="11"
                                   FontWeight="SemiBold" />
                        <ui:TextBox Margin="0,4,0,4"
                                    Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="e.g. 4.7.2 (auto-filled from UEX)" />
                        <TextBlock Margin="0,0,0,12" Opacity="0.65" FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="{Binding BranchLabel}" />

                        <TextBlock Text="DETAILS / NOTES" Opacity="0.6" FontSize="11"
                                   FontWeight="SemiBold" />
                        <ui:TextBox Margin="0,4,0,0"
                                    Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Optional context for the report" />
                    </StackPanel>
                </ui:CardExpander>

                </StackPanel>
            </ScrollViewer>

            <!-- Splitter + ScreenshotPanel — both visible only when SideBySideScreenshot is true. -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding SideBySideScreenshot, Converter={StaticResource BoolToVisibility}}" />

            <Border Grid.Column="2"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding SideBySideScreenshot, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Merged / multi-file inbox items: switch which source image
                         is shown (UEX still receives only the primary / first file). -->
                    <DockPanel Grid.Row="0"
                               LastChildFill="True"
                               Margin="6,6,6,2"
                               Visibility="{Binding HasMultiplePreviewSources, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Sources"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Opacity="0.65"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0" />
                        <ListBox ItemsSource="{Binding PreviewSourceChips}"
                                 SelectedIndex="{Binding ActivePreviewSourceIndex, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="MinWidth" Value="36" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ChipBd"
                                                        CornerRadius="4"
                                                        Padding="10,5"
                                                        Background="Transparent"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ChipBd" Property="Background"
                                                                Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter TargetName="ChipBd" Property="BorderBrush"
                                                                Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsSelected" Value="False" />
                                                            <Condition Property="IsMouseOver" Value="True" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="ChipBd" Property="Background"
                                                                Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PreviewSourceChip}">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <views:ScreenshotPanel Grid.Row="1"
                                           ImageSource="{Binding PreviewImage}"
                                           HeaderLabel="{Binding PreviewImageHeader}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: STICKY validation panel + send action bar. Lives outside any
             ScrollViewer so the user can NEVER scroll past it and forget there
             was an error blocking submission. -->
        <Border Grid.Row="2" Padding="20,8,20,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- Validation card — tinted by OverallSeverity. -->
                <ui:Card Margin="0,0,0,8" Padding="12,10">
                    <ui:Card.Style>
                        <Style TargetType="ui:Card">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OverallSeverity}" Value="Error">
                                    <Setter Property="Background" Value="#22C8504F" />
                                    <Setter Property="BorderBrush" Value="#88C8504F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OverallSeverity}" Value="Warning">
                                    <Setter Property="Background" Value="#22DAA520" />
                                    <Setter Property="BorderBrush" Value="#88DAA520" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Card.Style>
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left"
                                           Symbol="Warning24"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding OverallSeverity, Converter={StaticResource SeverityToBrush}}" />
                            <TextBlock Text="{Binding ValidationSummary}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,6,0,0"
                                      MaxHeight="100">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Ellipse DockPanel.Dock="Left"
                                                 Width="7" Height="7"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Opacity="0.9" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Manual override: visible ONLY when blocking errors are present.
                     Lets the user bypass the safety net by explicitly acknowledging
                     they reviewed every value themselves. Reset to false on every
                     screenshot Load() so the safety net is on by default. -->
                <Border Margin="0,0,0,8" Padding="10,8"
                        CornerRadius="4"
                        Background="#33C8504F" BorderBrush="#88C8504F" BorderThickness="1"
                        Visibility="{Binding HasBlockingErrors, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox IsChecked="{Binding UserOverrideValidation}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="I have manually reviewed every value above" FontWeight="SemiBold" />
                            <Run Text=" — submit anyway despite the blocking errors." />
                        </TextBlock>
                    </CheckBox>
                </Border>

                <!-- The send action is the only thing in this row now: the
                     production-mode toggle lives in Settings and applies to
                     every screenshot to avoid forgetting to flip it back. -->
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               Appearance="Primary"
                               Padding="22,10"
                               Command="{Binding SubmitCommand}"
                               ToolTip="{Binding ValidationSummary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Send to UEX" FontWeight="SemiBold" />
                            <ui:SymbolIcon Symbol="ArrowUpload24" Margin="8,0,0,0" />
                        </StackPanel>
                    </ui:Button>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
