<UserControl x:Class="DataRunner.App.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:abs="clr-namespace:DataRunner.Core.Abstractions;assembly=DataRunner.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:RoutesViewModel}"
             mc:Ignorable="d"
             xml:lang="en-US">

    <UserControl.Resources>
        <!-- ★ favourite-sort star embedded in every sortable column header.
             Clicking it toggles "this is my default sort column"; the lit
             state binds against the VM's DefaultSortMember (compared via
             the StringEquals converter with the column's SortMemberPath as
             parameter), and the click routes through ToggleDefaultSortCommand
             with that same path as parameter. Borderless, no background
             — it visually disappears against the column header until lit. -->
        <Style x:Key="SortFavoriteStar" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- 60% white = clearly visible on the dark header background but
                 still subordinate to the column title text. Earlier 40% was
                 nearly invisible until lit. -->
            <Setter Property="Foreground" Value="#AAFFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ToolTip" Value="Favourite this column as the default sort. Persisted across sessions." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="StarGlyph"
                                       Text="☆"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFE9C46A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StarGlyph" Property="Text" Value="★" />
                                <Setter Property="Foreground" Value="#FFFFC34D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped ToggleButton used by the trade-routes filter bar.
             Mirrors the look of the UEX website pills: rounded full-pill
             border, transparent fill when off, accent fill when on. Hover
             gets a subtle tint so the affordance is obvious. Scoped to this
             view because no other screen needs the pill look (yet). -->
        <Style x:Key="FilterPillToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#15FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#FF0078D4" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#FF0078D4" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER: Grid so title/description cannot starve the Refresh button (DockPanel + wide text measure clipped the last child). -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Trade routes"
                           FontSize="28" FontWeight="SemiBold" />
                <TextBlock Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="Profitable trade routes from UEX, sorted by a combined trader / datarunner score. Use the slider to balance profit vs the age of the stale-data refreshes you'd unlock at each endpoint." />
                </TextBlock>
            </StackPanel>
            <ui:Button Grid.Column="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Appearance="Secondary"
                       Command="{Binding RefreshCommand}"
                       Padding="14,7"
                       ToolTip="Forces a fresh fetch from UEX (commodities_routes + chained stale baseline). Throttled to once every 60s.">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Margin="0,0,6,0"
                                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0"
                                   Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="Refresh from UEX" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <!-- INFO BANNER -->
        <Border Grid.Row="1" Padding="12,8" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" Opacity="0.7" />
                <TextBlock VerticalAlignment="Center" Opacity="0.85">
                    <Run Text="Source: " />
                    <Run Text="GET /commodities_routes" FontFamily="Consolas" />
                    <Run Text=" — cached locally for 30 min. Last refresh: " />
                    <Run Text="{Binding LastRefreshedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=". Showing " />
                    <Run Text="{Binding FilteredCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text=" routes." />
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="16,0,0,0" Opacity="0.6"
                           VerticalAlignment="Center"
                           FontStyle="Italic" />
                <TextBlock Margin="16,0,0,0" Opacity="0.7"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#FF9DD9F0"
                           Text="{Binding OriginScopeLabel, StringFormat='Filtering: {0}'}"
                           ToolTip="Effective UEX filter applied to /commodities_routes for the current selection." />
            </StackPanel>
        </Border>

        <!-- FILTER BAR (origin / vehicle / investment / destination + numeric thresholds) -->
        <Border Grid.Row="2" Padding="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                    <TextBlock Text="Origin *"
                               FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center"
                               Opacity="0.8" />
                    <ComboBox DockPanel.Dock="Right" MinWidth="110"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding OriginScope, Mode=TwoWay}"
                              FontSize="11" Padding="6,1" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              ToolTip="Select what UEX filter we send to /commodities_routes:&#10;• Terminal: only this exact shop (e.g. Admin - CRU-L1)&#10;• Orbit: every terminal at the orbit (e.g. all of CRU-L1) — matches the UEX website&#10;• Planet: every terminal at the planet (e.g. Crusader)">
                        <ComboBoxItem Content="Terminal" Tag="{x:Static abs:RouteScope.Terminal}" />
                        <ComboBoxItem Content="Orbit" Tag="{x:Static abs:RouteScope.Orbit}" />
                        <ComboBoxItem Content="Planet" Tag="{x:Static abs:RouteScope.Planet}" />
                    </ComboBox>
                </DockPanel>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Vehicle"
                           FontWeight="SemiBold" FontSize="11"
                           Margin="12,0,0,4" Opacity="0.8" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="Investment max (aUEC)"
                           FontWeight="SemiBold" FontSize="11"
                           Margin="12,0,0,4" Opacity="0.8" />
                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="Destination terminal (optional)"
                           FontWeight="SemiBold" FontSize="11"
                           Margin="12,0,0,4" Opacity="0.8" />

                <!-- Origin: editable combo with type-to-search suggestions. -->
                <ComboBox Grid.Row="1" Grid.Column="0"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          ItemsSource="{Binding OriginSuggestions}"
                          DisplayMemberPath="RichDisplayName"
                          Text="{Binding OriginSearch, UpdateSourceTrigger=PropertyChanged}"
                          SelectedItem="{Binding SelectedOrigin, Mode=TwoWay}"
                          ToolTip="Type a terminal name (e.g. 'CRU-L4', 'Nyx Gateway Stanton'). Required to fetch routes." />

                <ComboBox Grid.Row="1" Grid.Column="1"
                          MinWidth="220" Margin="12,0,0,0"
                          ItemsSource="{Binding Vehicles}"
                          DisplayMemberPath="DisplayLabel"
                          SelectedItem="{Binding SelectedVehicle, Mode=TwoWay}"
                          ToolTip="Select your ship to filter out routes whose container sizes don't fit. Leave empty for no constraint." />

                <ui:TextBox Grid.Row="1" Grid.Column="2"
                            MinWidth="160" Margin="12,0,0,0"
                            PlaceholderText="e.g. 300000"
                            Text="{Binding InvestmentMaxUec, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                            ToolTip="Caps routes to those buyable within this UEC budget. Leave empty for no cap." />

                <ComboBox Grid.Row="1" Grid.Column="3"
                          Margin="12,0,0,0"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          ItemsSource="{Binding DestinationSuggestions}"
                          DisplayMemberPath="RichDisplayName"
                          Text="{Binding DestinationSearch, UpdateSourceTrigger=PropertyChanged}"
                          SelectedItem="{Binding SelectedDestination, Mode=TwoWay}"
                          ToolTip="Optional: pin a single destination terminal. Leave empty to see all destinations from origin." />

                <!-- ROW 2/3: numeric trader-side thresholds. Persisted across
                     sessions so a user who never wants to see micro-runs
                     keeps them filtered out without re-typing. -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Min profit (aUEC)"
                           FontWeight="SemiBold" FontSize="11"
                           Margin="0,12,0,4" Opacity="0.8" />
                <TextBlock Grid.Row="2" Grid.Column="3"
                           Text="Min profit / minute (aUEC/min)"
                           FontWeight="SemiBold" FontSize="11"
                           Margin="12,12,0,4" Opacity="0.8" />

                <ui:TextBox Grid.Row="3" Grid.Column="0"
                            PlaceholderText="e.g. 50000"
                            Text="{Binding MinProfit, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                            ToolTip="Hide every route whose budget-capped profit is below this aUEC threshold. Leave empty for no minimum." />
                <ui:TextBox Grid.Row="3" Grid.Column="3"
                            Margin="12,0,0,0"
                            PlaceholderText="e.g. 20000"
                            Text="{Binding MinProfitPerMinute, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                            ToolTip="Hide routes whose profit per minute of quantum travel is below this aUEC/min threshold. Surfaces efficient runs only — useful when you want short, high-margin trips instead of long hauls. Leave empty for no minimum." />
            </Grid>
        </Border>

        <!-- TRADER ↔ DATARUNNER SLIDER
             Note: the slider ranks rows by recomputing each TradeRouteProposal.DatarunnerScore.
             That ranking is only EFFECTIVE when the grid sort is on DatarunnerScore (the default).
             If the user has favourited another column with the ★ icon, the grid sorts on that
             column instead and the slider becomes visually inert. We keep the slider editable
             so the user can pre-set it, but we dim it and show a hint so the inertness isn't
             mistaken for a bug. -->
        <Border Grid.Row="3" Padding="12,10" Margin="0,0,0,12"
                CornerRadius="6">
            <!-- Background flips between the standard card colour (slider active)
                 and a darker, more-muted tone (slider inert). NOTE: do NOT set
                 Background as a local attribute — local values OUTRANK Style
                 triggers in WPF, which would freeze the trigger forever. -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DefaultSortMember, Converter={StaticResource StringIsNullOrEmpty}}" Value="False">
                            <Setter Property="Background" Value="#33000000" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- TOP banner — shows ABOVE the slider so the explanation is
                     read FIRST, before the user starts wondering why the
                     control underneath doesn't respond. WPF rule applied:
                     Visibility/Background are ONLY set via Style setters (no
                     local attribute), otherwise the DataTrigger override
                     would be ignored due to local-value precedence. -->
                <Border Margin="0,0,0,8"
                        Padding="12,8"
                        CornerRadius="4"
                        BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Background" Value="#55D32F2F" />
                            <Setter Property="BorderBrush" Value="#FFFF5252" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DefaultSortMember, Converter={StaticResource StringIsNullOrEmpty}}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFEBEB">
                        <Run Text="⛔ Slider disabled — favorite sort " />
                        <Run Text="★ " FontSize="16" FontWeight="Bold" Foreground="#FFFFC34D" />
                        <Run Text="is active on column " />
                        <Run Text="{Binding DefaultSortMember, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFC34D" />
                        <Run Text=". Click the yellow ★ in that column header to clear it and re-enable Trader ↔ Datarunner ranking." />
                    </TextBlock>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Trader" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="Pure UEX profit ranking. Slider at 0% sorts strictly by profit margin." />
                    </StackPanel>
                    <!-- IsEnabled bound to (DefaultSortMember is null/empty) so
                         the slider gets the standard WPF disabled visual the
                         moment a column is ★-favourited. The Modern (iNKORE)
                         theme's disabled-Slider state is too subtle on its own,
                         so we ALSO crush opacity to 0.35 via a Style trigger.
                         Combined with the red banner above and the dark panel
                         background, the disabled state is unmistakable. -->
                    <Slider Grid.Column="1"
                            Minimum="0" Maximum="100"
                            Value="{Binding DatarunnerSliderValue, Mode=TwoWay}"
                            IsEnabled="{Binding DefaultSortMember, Converter={StaticResource StringIsNullOrEmpty}}"
                            TickFrequency="10"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="False"
                            VerticalAlignment="Center"
                            ToolTip="Sort weight applied to every row's DatarunnerScore:&#10;• 0% (pure Trader) → score = budget-capped profit only (5M aUEC = full saturation).&#10;• 100% (pure Datarunner) → score = 0.7 × max stale age (180 d = full saturation) + 0.3 × stale row count (10+ rows = saturation).&#10;The default 30% favours profit but lifts very-stale routes near the top.&#10;&#10;NOTE: the slider only re-orders rows while the grid is sorted by DatarunnerScore. When a column is ★-favourited, the grid sorts on that column instead and the slider is frozen (it still recomputes the score in the background, so ratings come back the moment you un-favourite the column).">
                        <Slider.Style>
                            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                <Setter Property="Opacity" Value="1.0" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Datarunner" FontWeight="SemiBold" VerticalAlignment="Center"
                                   ToolTip="Datarunner-side score blends the AGE of the oldest stale price you'd refresh at this route's endpoints (primary) with the COUNT of stale rows there (secondary). A 320-day route with 2 rows beats a 31-day route with 8 rows." />
                        <TextBlock Text="{Binding DatarunnerSliderValue, StringFormat='{}  ({0:F0}%)', ConverterCulture=en-US}"
                                   Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- PILL FILTERS — mirror of the UEX trade-routes page filter bar.
             All toggles are client-side AND constraints over the cached
             proposals, persisted across sessions. ToolTips spell out the
             exact effect so the user never has to guess what a pill does. -->
        <Border Grid.Row="4" Padding="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterLoadingDock, Mode=TwoWay}"
                              Content="Loading"
                              ToolTip="Keep only routes whose ORIGIN AND DESTINATION both have a loading dock (manual SCU loading via the cargo ramp)." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterFreightElevator, Mode=TwoWay}"
                              Content="Auto-load"
                              ToolTip="Keep only routes where both endpoints expose a freight elevator (auto-load through the terminal interface)." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterLegal, Mode=TwoWay}"
                              Content="Legal"
                              ToolTip="Hide routes trading illegal commodities (Altruciatoxin, WiDoW, etc.). Looked up against the local commodity catalog." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterMonitored, Mode=TwoWay}"
                              Content="Monitored"
                              ToolTip="Keep only routes whose endpoints are monitored terminals (UEX auto-tracks pricing — usually well-curated stations)." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterSpace, Mode=TwoWay}"
                              Content="Space"
                              ToolTip="Keep only routes between two space stations (no atmospheric entry on either end)." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterGround, Mode=TwoWay}"
                              Content="Ground"
                              ToolTip="Keep only routes between two ground-based terminals." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterRefuel, Mode=TwoWay}"
                              Content="Refuel"
                              ToolTip="Keep only routes where both endpoints offer refuelling on-site (full top-off both ways)." />
                <ToggleButton Style="{StaticResource FilterPillToggle}"
                              IsChecked="{Binding FilterPredicted, Mode=TwoWay}"
                              Content="Predicted"
                              ToolTip="Keep only routes where at least one side has a predicted price (no recent user submissions). Useful for datarunners targeting routes worth confirming." />
            </WrapPanel>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="5"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <Grid>
                <!-- Placeholder shown when no proposals: either no origin selected
                     OR origin returned 0 routes (e.g. investment cap too low). -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="520">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:SymbolIcon Symbol="Map24" FontSize="48" HorizontalAlignment="Center" Opacity="0.3" />
                    <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"
                               HorizontalAlignment="Center" Opacity="0.85"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="No trade routes to show" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrigin}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Pick an origin terminal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Type a terminal name above to see routes from it. Optionally cap investment, pin a destination, or pick your ship to filter by container size." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedOrigin, Converter={StaticResource BoolToVisibility}}" Value="Visible">
                                        <Setter Property="Text" Value="UEX returned 0 profitable routes from this origin within the current filters. Try raising the investment cap, removing the optional destination, or picking another origin." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <DataGrid ItemsSource="{Binding View}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      AlternatingRowBackground="#10FFFFFF"
                      RowBackground="Transparent"
                      Sorting="RoutesGrid_OnSorting"
                      Margin="6">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Open in UEX (browser)"
                                              Command="{Binding DataContext.OpenInBrowserCommand,
                                                                 RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- ORIGIN — opens UEX on the commodity's "where to BUY"
                         tab so the user lands directly on the page that
                         lists this commodity's buy locations (origin context). -->
                    <DataGridTemplateColumn Header="Origin" Width="180" SortMemberPath="Route.OriginTerminalName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock FontWeight="SemiBold">
                                        <Hyperlink Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Command="{Binding DataContext.OpenOriginTerminalCommand,
                                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Open on UEX — page 'where to BUY this commodity', with this terminal in the list (origin context).">
                                            <Run Text="{Binding Route.OriginTerminalName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Opacity="0.6">
                                        <Run Text="{Binding Route.OriginPlanetName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Route.OriginStarSystemName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- DESTINATION — opens UEX on the commodity's "where to
                         SELL" tab so the right side (Achat) is preselected. -->
                    <DataGridTemplateColumn Header="Destination" Width="180" SortMemberPath="Route.DestinationTerminalName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock FontWeight="SemiBold">
                                        <Hyperlink Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Command="{Binding DataContext.OpenDestinationTerminalCommand,
                                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Open on UEX — page 'where to SELL this commodity', with this terminal in the list (destination context).">
                                            <Run Text="{Binding Route.DestinationTerminalName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Opacity="0.6">
                                        <Run Text="{Binding Route.DestinationPlanetName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Route.DestinationStarSystemName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COMMODITY -->
                    <DataGridTextColumn Header="Commodity" Width="140"
                                        Binding="{Binding Route.CommodityName}" />

                    <!-- SCU -->
                    <DataGridTextColumn Width="80"
                                        SortMemberPath="EffectiveScu"
                                        Binding="{Binding EffectiveScu, StringFormat='{}{0:N0}'}"
                                        ToolTipService.ToolTip="Maximum SCU buyable from the listed origin within the current investment cap. With no cap this equals the full origin stock.">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SCU" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=EffectiveScu, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="EffectiveScu" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- INVESTMENT -->
                    <DataGridTextColumn Width="155"
                                        SortMemberPath="EffectiveInvestment">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Invested (aUEC)" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=EffectiveInvestment, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="EffectiveInvestment" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="EffectiveInvestment" Converter="{StaticResource SmartNumber}" />
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- PROFIT (budget-capped) -->
                    <DataGridTextColumn Width="130"
                                        SortMemberPath="EffectiveProfit">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Profit (aUEC)" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=EffectiveProfit, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="EffectiveProfit" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.Binding>
                            <Binding Path="EffectiveProfit" Converter="{StaticResource SmartNumber}" />
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- PROFIT / MIN — derived from EstimatedTravelTime. Shows the
                         REAL efficiency of a route, accounting for travel cost.
                         Compact format ("57.6K") gets a much better visual scan
                         than full precision; the raw double stays bound for
                         sorting purposes and the tooltip shows the exact value. -->
                    <DataGridTextColumn Width="100"
                                        SortMemberPath="ProfitPerMinute"
                                        Binding="{Binding ProfitPerMinute, Converter={StaticResource CompactNumber}}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="aUEC/min" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=ProfitPerMinute, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="ProfitPerMinute" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="Opacity" Value="0.85" />
                                <Setter Property="ToolTipService.ToolTip">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="Exact: {0:N2} aUEC/min&#10;&#10;Effective profit divided by quantum-travel ETA. Higher = more efficient. Routes with distance=0 (intra-station) display the raw profit since travel is instant.">
                                            <Binding Path="ProfitPerMinute" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ROI -->
                    <DataGridTextColumn Width="75"
                                        SortMemberPath="Route.PriceRoi"
                                        Binding="{Binding Route.PriceRoi, StringFormat='{}{0:N0}\%', ConverterCulture=en-US}"
                                        ToolTipService.ToolTip="ROI per SCU = (sell price − buy price) / buy price. UEX returns this in percent units.">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ROI" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=Route.PriceRoi, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="Route.PriceRoi" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- DISTANCE -->
                    <DataGridTextColumn Width="95"
                                        SortMemberPath="Route.Distance"
                                        Binding="{Binding Route.Distance, StringFormat='{}{0:F1} Gm', ConverterCulture=en-US}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Distance" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=Route.Distance, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="Route.Distance" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="Opacity" Value="0.7" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ETA — derived from Distance + a fixed quantum-drive baseline.
                         Mirrors the ETA column shown on the UEX trade-routes web page. -->
                    <DataGridTextColumn Width="80"
                                        SortMemberPath="EstimatedTravelTime"
                                        Binding="{Binding EstimatedTravelTime, Converter={StaticResource Eta}}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ETA" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=EstimatedTravelTime, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="EstimatedTravelTime" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="Opacity" Value="0.85" />
                                <Setter Property="ToolTip" Value="Estimated quantum travel time. Computed from distance using a 175 Mm/s drive baseline + 10 s spool/calibration. Per-vehicle quantum speeds aren't exposed by UEX, so this is a generic mid-range hauler approximation — comparisons between routes are still meaningful." />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- CONTAINER SIZES -->
                    <DataGridTextColumn Header="Containers" Width="120"
                                        Binding="{Binding Route.ContainerSizesOrigin}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="ToolTip" Value="Container sizes accepted at the origin terminal (CSV in SCU). The selected vehicle filter hides routes whose set is incompatible." />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- UEX SCORE -->
                    <DataGridTextColumn Width="95"
                                        SortMemberPath="Route.Score"
                                        Binding="{Binding Route.Score}">
                        <DataGridTextColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Score" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=Route.Score, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="Route.Score" />
                            </StackPanel>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="Opacity" Value="0.6" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="ToolTip" Value="UEX-computed qualitative score (higher is better). Treat as opaque ranking; their algorithm crunches volatility, recency and stock." />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- STALE — datarunner overlay. Headline number is the AGE of THIS
                         commodity's price (buy at origin, sell at destination), so the
                         displayed value matches what UEX shows on its terminal page for
                         the exact row you're trading. Tooltip adds the terminal-wide
                         context (any commodity) for refresh-route planning. -->
                    <DataGridTemplateColumn Width="100" SortMemberPath="MaxDaysStaleThisRoute">
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Stale" />
                                <ToggleButton Style="{StaticResource SortFavoriteStar}"
                                              IsChecked="{Binding DataContext.DefaultSortMember, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource StringEquals}, ConverterParameter=MaxDaysStaleThisRoute, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleDefaultSortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="MaxDaysStaleThisRoute" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Margin="6,2" Padding="6,2"
                                        CornerRadius="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#3322C55E" />
                                            <Setter Property="BorderBrush" Value="#FF22C55E" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MaxDaysStaleThisRoute}" Value="0">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↻ "
                                                   FontWeight="SemiBold"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="{Binding MaxDaysStaleThisRoute, Mode=OneWay}" />
                                            <Run Text="d" FontSize="10" BaselineAlignment="Center" />
                                        </TextBlock>
                                        <TextBlock Margin="6,0,0,0"
                                                   FontSize="10"
                                                   Opacity="0.65"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TotalStale, StringFormat='({0})'}" />
                                    </StackPanel>
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="460">
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="Stale data — this trade vs. these terminals" />
                                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="The big number (↻ Nd) is the age of THIS commodity's price for THIS trade — buy price at origin, sell price at destination. It matches what UEX shows on the route grid. The number in (parens) is the broader datarunner-refresh count: total commodities ≥30 days old at either terminal, minus what you submitted in the last 6 h." />
                                                </TextBlock>
                                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" FontSize="11" Opacity="0.85" Text="THIS commodity (matches UEX)" />
                                                <TextBlock Margin="0,2,0,0" FontFamily="Consolas">
                                                    <Run Text="Buy  @ origin       : " />
                                                    <Run Text="{Binding DaysStaleAtOriginThisCommodity, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" d" />
                                                    <LineBreak />
                                                    <Run Text="Sell @ destination  : " />
                                                    <Run Text="{Binding DaysStaleAtDestinationThisCommodity, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" d" />
                                                </TextBlock>
                                                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" FontSize="11" Opacity="0.85" Text="Any commodity at these terminals (refresh potential)" />
                                                <TextBlock Margin="0,2,0,0" FontFamily="Consolas">
                                                    <Run Text="Origin      — oldest: " />
                                                    <Run Text="{Binding MaxDaysStaleAtOriginAnyCommodity, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" d, count ≥30d: " />
                                                    <Run Text="{Binding StaleAtOrigin, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <LineBreak />
                                                    <Run Text="Destination — oldest: " />
                                                    <Run Text="{Binding MaxDaysStaleAtDestinationAnyCommodity, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text=" d, count ≥30d: " />
                                                    <Run Text="{Binding StaleAtDestination, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <LineBreak />
                                                    <Run Text="Excluded (you submitted &lt; 6 h ago): " />
                                                    <Run Text="{Binding StaleExcludedRecentlySubmitted, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                                <TextBlock Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap" FontStyle="Italic">
                                                    <Run Text="The 30-day threshold on the (count) matches the Targets view default filter, so the same terminal shows consistent numbers in both screens. Click 'Refresh from UEX' to force-sync the stale baseline (cache TTL is 6 h)." />
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
