<UserControl x:Class="DataRunner.App.Views.FirstRunWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:FirstRunWizardViewModel}"
             mc:Ignorable="d">

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="8" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Welcome to SC DataRunner"
                           FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,4,0,16"
                           HorizontalAlignment="Center" Opacity="0.7"
                           Text="A tiny one-time setup, then you're ready to share trade data with the community." />
            </StackPanel>

            <Grid Grid.Row="1" MinHeight="280">
                <!-- Step visibility is driven by VM helper booleans (ShowXxxStep)
                     so the wizard transparently collapses the bearer-token step
                     when the build embeds an app token (official CI release).
                     The folder step's slot becomes step 2 in that case, instead
                     of step 3, but the XAML stays the same. -->

                <!-- Welcome -->
                <StackPanel Visibility="{Binding ShowWelcomeStep, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" Margin="0,16,0,12" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="500"
                               Text="This app reads your in-game commodity terminal screenshots, lets you review every value, and sends the results to UEX with one click. OCR runs entirely on your machine; nothing leaves before you press Send." />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Opacity="0.7"
                               Text="Open-source, free, AGPL-3.0 licensed." />
                </StackPanel>

                <!-- User secret-key -->
                <StackPanel Visibility="{Binding ShowSecretKeyStep, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Key24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4">
                        <Run Text="{Binding SecretKeyStepLabel, Mode=OneWay}" />
                        <Run Text=" — Paste your USER secret-key" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="500" Opacity="0.75"
                               Text="This identifies YOU on UEX. Open your account page, scroll to the 'Secret Key' section and copy the value. Encrypted at rest with Windows DPAPI; stays only on this PC." />
                    <ui:HyperlinkButton HorizontalAlignment="Center" Margin="0,4,0,12"
                                        Content="Open uexcorp.space/account → Secret Key"
                                        Command="{Binding OpenUexAccountPageCommand}" />
                    <ui:PasswordBox MaxWidth="480"
                                    Password="{Binding SecretKeyInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    PlaceholderText="user secret-key" />
                </StackPanel>

                <!-- App bearer token (skipped when the build has one embedded) -->
                <StackPanel Visibility="{Binding ShowBearerInputStep, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="AppFolder24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="2/3 — Paste your APP bearer token"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="500" Opacity="0.75"
                               Text="This build does not embed an app token (you're running a self-built or development binary). UEX requires a SECOND credential identifying the application — create one on the My Apps page and paste the bearer token below." />
                    <ui:HyperlinkButton HorizontalAlignment="Center" Margin="0,4,0,12"
                                        Content="Open uexcorp.space/api/apps → create app"
                                        Command="{Binding OpenUexAppsPageCommand}" />
                    <ui:PasswordBox MaxWidth="480"
                                    Password="{Binding BearerTokenInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    PlaceholderText="app bearer token" />
                </StackPanel>

                <!-- Submission mode (is_production) -->
                <StackPanel Visibility="{Binding ShowSubmissionModeStep, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4">
                        <Run Text="{Binding SubmissionModeStepLabel, Mode=OneWay}" />
                        <Run Text=" — Submission mode (is_production)" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="540" Opacity="0.75"
                               Text="Every report you send to UEX has a flag called is_production. PRODUCTION reports go LIVE on uexcorp.space and update the public commodity prices everyone uses. TEST reports are recorded in your account but don't affect public prices — useful for debugging or trying the app." />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="540" Opacity="0.65" FontSize="11" Margin="0,8,0,12"
                               FontStyle="Italic"
                               Text="Independent of LIVE/PTU game build: even a TEST submission keeps its game_version tag. You can flip this on a per-submission basis in the confirm dialog before sending." />
                    <Border MaxWidth="500" HorizontalAlignment="Center"
                            Padding="14,10" CornerRadius="6"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <CheckBox IsChecked="{Binding DefaultIsProduction, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Send submissions in PRODUCTION mode by default"
                                           FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,2,0,0"
                                           Text="Recommended. Uncheck to start in TEST mode while you get familiar with the app — you can flip this back in Settings any time." />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>

                <!-- Folder (LIVE + optional PTU) -->
                <StackPanel Visibility="{Binding ShowFolderStep, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4">
                        <Run Text="{Binding FolderStepLabel, Mode=OneWay}" />
                        <Run Text=" — Star Citizen screenshots folders" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="540" Opacity="0.75"
                               Text="Star Citizen writes screenshots to a different folder per game build (LIVE vs PTU). We watch both, and each screenshot is automatically tagged with the matching build number from UEX. You can change this later in Settings." />

                    <!-- LIVE -->
                    <StackPanel Margin="0,16,0,0" MaxWidth="540">
                        <DockPanel Margin="0,0,0,4">
                            <Border CornerRadius="3" Padding="6,2"
                                    Background="#1FA34A" VerticalAlignment="Center">
                                <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Text="LIVE channel folder"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding LiveScreenshotsFolder, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="e.g. D:\Jeux\StarCitizen\LIVE\Screenshots" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="14,7"
                                       Command="{Binding BrowseLiveFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderArrowRight24" Margin="0,0,6,0" />
                                    <TextBlock Text="Browse..." />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>

                    <!-- PTU (optional) -->
                    <StackPanel Margin="0,12,0,0" MaxWidth="540">
                        <DockPanel Margin="0,0,0,4">
                            <Border CornerRadius="3" Padding="6,2"
                                    Background="#D97706" VerticalAlignment="Center">
                                <TextBlock Text="PTU" FontSize="10" FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock Text="PTU channel folder (optional)"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0"
                                        Text="{Binding PtuScreenshotsFolder, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Leave empty if you don't run PTU" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="14,7"
                                       Command="{Binding BrowsePtuFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderArrowRight24" Margin="0,0,6,0" />
                                    <TextBlock Text="Browse..." />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                <ui:Button DockPanel.Dock="Left" Padding="14,7"
                           Appearance="Secondary"
                           Command="{Binding GoBackCommand}"
                           IsEnabled="{Binding CanGoBack}"
                           Content="Back" />
                <ui:Button DockPanel.Dock="Right" Padding="20,7"
                           HorizontalAlignment="Right"
                           Appearance="Primary"
                           Command="{Binding GoNextCommand}"
                           IsEnabled="{Binding CanGoNext}">
                    <TextBlock>
                        <Run Text="Next " />
                        <Run Text="" />
                    </TextBlock>
                </ui:Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
