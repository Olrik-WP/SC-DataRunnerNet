<UserControl x:Class="DataRunner.App.Views.FirstRunWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:FirstRunWizardViewModel}"
             mc:Ignorable="d">

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="8" Padding="32">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Welcome to SC DataRunner"
                           FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Margin="0,4,0,16"
                           HorizontalAlignment="Center" Opacity="0.7"
                           Text="A tiny one-time setup, then you're ready to share trade data with the community." />
            </StackPanel>

            <Grid Grid.Row="1" MinHeight="280">
                <!-- Step 0: Welcome -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=0}">
                    <ui:SymbolIcon Symbol="Rocket24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" Margin="0,16,0,12" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="500"
                               Text="This app reads your in-game commodity terminal screenshots, lets you review every value, and sends the results to UEX with one click. OCR runs entirely on your machine; nothing leaves before you press Send." />
                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Opacity="0.7"
                               Text="Open-source, free, MIT-licensed." />
                </StackPanel>

                <!-- Step 1: User secret-key -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=1}">
                    <ui:SymbolIcon Symbol="Key24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="1/2 — Paste your USER secret-key"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="500" Opacity="0.75"
                               Text="This identifies YOU on UEX. Open your account page, scroll to the 'Secret Key' section and copy the value. Encrypted at rest with Windows DPAPI; stays only on this PC." />
                    <ui:HyperlinkButton HorizontalAlignment="Center" Margin="0,4,0,12"
                                        Content="Open uexcorp.space/account → Secret Key"
                                        Command="{Binding OpenUexAccountPageCommand}" />
                    <ui:PasswordBox MaxWidth="480"
                                    Password="{Binding SecretKeyInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    PlaceholderText="user secret-key" />
                </StackPanel>

                <!-- Step 2: App bearer token -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=2}">
                    <ui:SymbolIcon Symbol="AppFolder24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="2/2 — Paste your APP bearer token"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="500" Opacity="0.75"
                               Text="UEX requires a SECOND credential identifying the application. Open the My Apps page, create one (e.g. 'SC DataRunner Net') and copy the generated bearer token." />
                    <ui:HyperlinkButton HorizontalAlignment="Center" Margin="0,4,0,12"
                                        Content="Open uexcorp.space/api/apps → create app"
                                        Command="{Binding OpenUexAppsPageCommand}" />
                    <ui:PasswordBox MaxWidth="480"
                                    Password="{Binding BearerTokenInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    PlaceholderText="app bearer token" />
                </StackPanel>

                <!-- Step 3: Folder -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibility}, ConverterParameter=3}">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Star Citizen screenshots folder"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="500" Opacity="0.75"
                               Text="The app will watch this folder and queue every new screenshot in your Inbox. You can change it later in Settings." />
                    <Grid Margin="0,12,0,0" MaxWidth="480">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding ScreenshotsFolder, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="C:\Users\...\Roberts Space Industries\ScreenShots" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0"
                                   Padding="14,7"
                                   Command="{Binding BrowseFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderArrowRight24" Margin="0,0,6,0" />
                                <TextBlock Text="Browse..." />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0">
                <ui:Button DockPanel.Dock="Left" Padding="14,7"
                           Appearance="Secondary"
                           Command="{Binding GoBackCommand}"
                           IsEnabled="{Binding CanGoBack}"
                           Content="Back" />
                <ui:Button DockPanel.Dock="Right" Padding="20,7"
                           HorizontalAlignment="Right"
                           Appearance="Primary"
                           Command="{Binding GoNextCommand}"
                           IsEnabled="{Binding CanGoNext}">
                    <TextBlock>
                        <Run Text="Next " />
                        <Run Text="" />
                    </TextBlock>
                </ui:Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
