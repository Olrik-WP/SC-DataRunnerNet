<Window x:Class="DataRunner.App.Views.Dialogs.ConfirmSubmitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:ConfirmSubmitViewModel}"
        mc:Ignorable="d"
        Title="Confirm submission to UEX"
        Width="900" Height="720"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Review before sending to UEX"
                       FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SeverityHeadline}"
                       Margin="0,4,0,0" FontSize="14" Opacity="0.85" />
        </StackPanel>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: validation + duplicates -->
            <ScrollViewer Grid.Column="0" Margin="0,0,8,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <ui:Card Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Validation issues"
                                           FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           FontSize="11" Opacity="0.55"
                                           Text="{Binding Issues.Count, StringFormat='{}{0} issue(s)'}" />
                            </DockPanel>
                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <Border Width="6" Margin="0,3,8,3"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                <StackPanel>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="[" /><Run Text="{Binding Severity}" /><Run Text="] " /><Run Text="{Binding Code}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                               Opacity="0.85" FontSize="12" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Margin="0,4,0,0" Opacity="0.6" FontSize="11"
                                       Text="No issues" Visibility="{Binding Issues.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Padding="16,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Live diff vs UEX (commodities_raw_prices)"
                                           FontWeight="SemiBold" />
                                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           FontSize="11" Opacity="0.55"
                                           Text="{Binding Findings.Count, StringFormat='{}{0} finding(s)'}" />
                            </DockPanel>
                            <!-- Internal MaxHeight + ScrollViewer prevents a long
                                 list of findings from pushing the bottom checkboxes
                                 + Send button off screen. The outer column also
                                 scrolls; this just stops THIS card from being the
                                 entire body. -->
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <Border Width="6" Margin="0,3,8,3"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                <StackPanel>
                                                    <TextBlock FontSize="12">
                                                        <Run Text="[" /><Run Text="{Binding Severity}" /><Run Text="] " /><Run Text="{Binding CommodityLabel}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                                               Opacity="0.85" FontSize="12" />
                                                    <TextBlock Opacity="0.55" FontSize="11">
                                                        <Run Text="local " /><Run Text="{Binding LocalValue, StringFormat='F2'}" />
                                                        <Run Text="  ·  remote " /><Run Text="{Binding RemoteValue, StringFormat='F2'}" />
                                                        <Run Text="  ·  diff " /><Run Text="{Binding PercentDifference, StringFormat='P1'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Margin="0,4,0,0" Opacity="0.6" FontSize="11"
                                       Text="No live diff (probably new data)"
                                       Visibility="{Binding Findings.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: payload preview -->
            <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,12,14,4">
                        <TextBlock Text="Exact JSON sent to UEX" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   FontSize="11" Opacity="0.55"
                                   Text="POST https://api.uexcorp.space/2.0/data_submit" />
                    </DockPanel>
                    <ScrollViewer Margin="14,4,14,12" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding PreviewJson, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="Transparent" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                </DockPanel>
            </ui:Card>
        </Grid>

        <!-- FOOTER
             Layout: 2-row Grid so checkboxes (row 0) never share horizontal
             space with the pills + buttons (row 1). This prevents the pill
             row from being squashed when the warning/block checkboxes are
             visible at the same time. -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,16,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Checkboxes — collapses to 0 when neither is visible -->
                    <RowDefinition Height="Auto" />
                    <!-- Pills (left) + Cancel / Send buttons (right) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Checkboxes (conditional) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <CheckBox IsChecked="{Binding AcknowledgeWarnings}"
                              Content="I have reviewed the warnings above"
                              Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox IsChecked="{Binding OverrideBlock}"
                              Margin="0,4,0,0"
                              Foreground="IndianRed"
                              ToolTip="The validator may be wrong (e.g. a previous attempt failed but was logged locally). Use this to force-send anyway and let UEX decide."
                              Content="Override BLOCK and send anyway (UEX will be the final judge)"
                              Visibility="{Binding HasBlockingIssues, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Row 1: Pills on the left, Cancel + Send on the right.
                     DockPanel ensures buttons always stay right-aligned
                     regardless of how much text the pills/note take. -->
                <DockPanel Grid.Row="1">

                    <!-- Buttons — docked right FIRST so they always stay
                         flush-right even when the left side wraps. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <ui:Button Padding="16,7" Margin="0,0,8,0"
                                   Appearance="Secondary"
                                   Click="OnCancelClick"
                                   Content="Cancel" />
                        <ui:Button Padding="22,7"
                                   Appearance="Primary"
                                   IsEnabled="{Binding CanSend}"
                                   Click="OnSendClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Send to UEX" FontWeight="SemiBold" />
                                <ui:SymbolIcon Symbol="ArrowUpload24" Margin="8,0,0,0" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- Pills + optional PTU note -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- Mode pill: olive tint for TEST, red tint for PRODUCTION -->
                            <Border Padding="8,3" CornerRadius="3" Margin="0,0,6,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#BF92700A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProduction}" Value="True">
                                                <Setter Property="Background" Value="#BFC0392B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="Mode: " /><Run Text="{Binding ModeLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                            <!-- Branch pill: green for LIVE, orange for PTU -->
                            <Border Padding="8,3" CornerRadius="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#BF1A7A3F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPtuBranch}" Value="True">
                                                <Setter Property="Background" Value="#BFB45309" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                                    <Run Text="Branch: " /><Run Text="{Binding BranchLabel, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <!-- PTU warning note — only shown for PTU branch -->
                        <TextBlock Margin="0,4,0,0" Opacity="0.65" FontSize="10" TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Visibility="{Binding IsPtuBranch, Converter={StaticResource BoolToVisibility}}"
                                   Text="UEX may temporarily reject PTU reports during patch transitions (ptu_reports_not_allowed). Your submission is always kept in the local History either way." />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
