<Window x:Class="DataRunner.App.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:DataRunner.App.Views"
        Title="Screenshot preview"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F0000000"
        AllowsTransparency="False"
        ShowInTaskbar="False">

    <Grid>
        <!-- Reusable viewer with zoom + pan. Same control used in the docked
             side-by-side panel inside ScreenshotEditView. -->
        <views:ScreenshotPanel x:Name="Viewer"
                               ImageSource="{Binding}"
                               HeaderLabel="Screenshot preview" />

        <!-- Fullscreen-only Close button (the docked variant doesn't need one,
             since the user closes via the side-by-side toggle). -->
        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,8,16,0"
                   Appearance="Transparent"
                   Padding="8,4"
                   Click="Close_Click"
                   ToolTip="Close (Esc)">
            <ui:SymbolIcon Symbol="Dismiss24" Foreground="White" />
        </ui:Button>

        <!-- Hint -->
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="0,0,0,18"
                   Foreground="White" Opacity="0.5" FontSize="11"
                   Text="Scroll: zoom · Click image: zoom step · Esc: close" />
    </Grid>
</Window>
