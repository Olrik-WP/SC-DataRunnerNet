<Window x:Class="DataRunner.App.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Screenshot preview"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F0000000"
        AllowsTransparency="False"
        ShowInTaskbar="False">

    <Grid>
        <!-- Image: drag to pan when zoomed in, wheel to zoom -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      Background="Transparent">
            <Image x:Name="PreviewImage"
                   Source="{Binding}"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Cursor="Hand"
                   MouseWheel="PreviewImage_MouseWheel"
                   MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown">
                <Image.LayoutTransform>
                    <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                </Image.LayoutTransform>
            </Image>
        </ScrollViewer>

        <!-- Top toolbar -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#88000000" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding ., FallbackValue='Screenshot preview'}"
                           Foreground="White" FontSize="13" Opacity="0.7"
                           VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ui:Button Appearance="Transparent"
                               Padding="8,4" Margin="0,0,4,0"
                               Click="ZoomOut_Click"
                               ToolTip="Zoom out (or scroll wheel)">
                        <ui:SymbolIcon Symbol="ZoomOut24" Foreground="White" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               Padding="8,4" Margin="0,0,4,0"
                               Click="ZoomReset_Click"
                               ToolTip="Reset zoom">
                        <TextBlock Text="100%" Foreground="White" FontSize="12" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               Padding="8,4" Margin="0,0,4,0"
                               Click="ZoomIn_Click"
                               ToolTip="Zoom in (or scroll wheel)">
                        <ui:SymbolIcon Symbol="ZoomIn24" Foreground="White" />
                    </ui:Button>
                    <ui:Button Appearance="Transparent"
                               Padding="8,4" Margin="12,0,0,0"
                               Click="Close_Click"
                               ToolTip="Close (Esc)">
                        <ui:SymbolIcon Symbol="Dismiss24" Foreground="White" />
                    </ui:Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hint -->
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="0,0,0,18"
                   Foreground="White" Opacity="0.5" FontSize="11"
                   Text="Scroll: zoom · Click image: zoom step · Esc: close" />
    </Grid>
</Window>
