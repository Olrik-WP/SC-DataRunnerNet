<UserControl x:Class="DataRunner.App.Views.TargetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DataRunner.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TargetsViewModel}"
             mc:Ignorable="d"
             xml:lang="en-US">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Stale data targets"
                           FontSize="28" FontWeight="SemiBold" />
                <TextBlock Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="(terminal, commodity) pairs in greatest need of a fresh report — sorted by priority. Pick one, fly there, screenshot it." />
                </TextBlock>
            </StackPanel>
            <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Appearance="Secondary"
                       Command="{Binding RefreshCommand}"
                       IsEnabled="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                       Padding="14,7"
                       ToolTip="Forces a fresh fetch from UEX. Throttled to once every 5 minutes.">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="14" Height="14"
                                     Margin="0,0,6,0"
                                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0"
                                   Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    <TextBlock Text="Refresh from UEX" />
                </StackPanel>
            </ui:Button>
        </DockPanel>

        <!-- INFO BANNER: cache age + counts -->
        <Border Grid.Row="1" Padding="12,8" Margin="0,0,0,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" Opacity="0.7" />
                <TextBlock VerticalAlignment="Center" Opacity="0.85">
                    <Run Text="Source: " />
                    <Run Text="GET /commodities_prices_all" FontFamily="Consolas" />
                    <Run Text=" — cached locally for 6 h. Last refresh: " />
                    <Run Text="{Binding LastRefreshedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=". Showing " />
                    <Run Text="{Binding FilteredCount, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" of " />
                    <Run Text="{Binding TotalCount, Mode=OneWay}" />
                    <Run Text=" actionable rows." />
                </TextBlock>
                <TextBlock VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Opacity="0.7"
                           FontStyle="Italic"
                           ToolTip="Phantom rows whose terminal was removed or renamed in a CIG patch. UEX still serves their last known prices via /commodities_prices_all but no datarunner can physically refresh them. Tick &quot;Show unreachable&quot; below to inspect them.">
                    <Run Text="(" />
                    <Run Text="{Binding UnreachableTotal, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" unreachable rows hidden)" />
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <!-- Visible only when there ARE unreachable rows AND the user hasn't ticked "Show unreachable". -->
                                <DataTrigger Binding="{Binding ShowUnreachable}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- Override: nothing to mention if zero phantoms exist. -->
                                <DataTrigger Binding="{Binding UnreachableTotal}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="16,0,0,0" Opacity="0.6"
                           VerticalAlignment="Center"
                           FontStyle="Italic" />
            </StackPanel>
        </Border>

        <!-- FILTER BAR -->
        <Border Grid.Row="2" Padding="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter by terminal, system, or commodity..."
                            Margin="0,0,12,0" />

                <CheckBox Grid.Column="1"
                          IsChecked="{Binding ShowOnlyOver30Days}"
                          Content="≥ 30 days only"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip="Hide rows that have been updated within the last month." />

                <CheckBox Grid.Column="2"
                          IsChecked="{Binding ShowBuy}"
                          Content="Buy"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Include rows where the terminal SELLS to players (player BUYs)." />

                <CheckBox Grid.Column="3"
                          IsChecked="{Binding ShowSell}"
                          Content="Sell"
                          VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="Include rows where the terminal BUYS from players (player SELLs)." />

                <CheckBox Grid.Column="4"
                          IsChecked="{Binding ShowUnreachable}"
                          Content="Show unreachable"
                          VerticalAlignment="Center"
                          Foreground="#FFFFCC80"
                          ToolTip="When unticked (default), rows whose terminal was removed or renamed in a CIG patch (no longer reachable in the current LIVE build) are hidden — they otherwise dominate the top of the list with 400+ day-old data nobody can physically refresh. Tick to inspect them, e.g. if you suspect UEX wrongly flagged a valid terminal as unavailable." />
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="6">
            <DataGrid ItemsSource="{Binding View}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      AlternatingRowBackground="#10FFFFFF"
                      RowBackground="Transparent"
                      Margin="6">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Open trade routes from this terminal in DataRunner"
                                              Command="{Binding DataContext.OpenRoutesInAppCommand,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Open trade routes from this terminal in browser (UEX)"
                                              Command="{Binding DataContext.OpenRoutesInBrowserCommand,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Days stale" Width="100" SortMemberPath="DaysStale">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="6,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding DaysStale, Converter={StaticResource DaysStaleToBrush}}" />
                                    <TextBlock Text="{Binding DaysStale}" FontWeight="SemiBold" />
                                    <TextBlock Text=" d" Opacity="0.6" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="System" Width="100"
                                        Binding="{Binding StarSystemName}" />

                    <DataGridTemplateColumn Header="Terminal" Width="2*" SortMemberPath="TerminalName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <Hyperlink Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Command="{Binding DataContext.OpenTerminalInBrowserCommand,
                                                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="Open this terminal's page on uexcorp.space">
                                            <Run Text="{Binding TerminalName, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <!-- Phantom-terminal badge: only shown when the user opted in
                                         via "Show unreachable" (otherwise these rows are filtered
                                         out entirely so the badge would never render anyway). -->
                                    <Border Margin="8,0,0,0"
                                            Padding="6,1"
                                            CornerRadius="3"
                                            Background="#33D97706"
                                            BorderBrush="#FFD97706"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"
                                            ToolTip="This terminal is no longer reachable in the current LIVE build (decommissioned, renamed, or purged from the UEX catalog after a CIG patch). Its prices cannot be refreshed by datarunners.">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReachable}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="⚠ unreachable"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFCC80" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Commodity" Width="*"
                                        Binding="{Binding CommodityName}" />

                    <DataGridTextColumn Header="Side" Width="60"
                                        Binding="{Binding Type}" />

                    <DataGridTextColumn Header="Last price (aUEC)" Width="140">
                        <DataGridTextColumn.Binding>
                            <Binding Path="LastKnownPrice" Converter="{StaticResource SmartNumber}" />
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Last updated" Width="140"
                                        Binding="{Binding LastUpdatedAt, StringFormat='yyyy-MM-dd', ConverterCulture=en-US}" />

                    <DataGridTextColumn Header="Priority" Width="80">
                        <DataGridTextColumn.Binding>
                            <Binding Path="PriorityScore" StringFormat="N0" />
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="Opacity" Value="0.7" />
                                <Setter Property="FontFamily" Value="Consolas" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
